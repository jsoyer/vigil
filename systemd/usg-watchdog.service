[Unit]
Description=USG Connection Watchdog -- Surveillance fibre + reboot automatique USG Ubiquiti
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=usg-watchdog
Group=usg-watchdog
WorkingDirectory=/opt/usg-watchdog/src

ExecStart=/opt/usg-watchdog/venv/bin/python /opt/usg-watchdog/src/watchdog.py

# Restart on crash
Restart=always
RestartSec=15

# Secrets via EnvironmentFile (chmod 600 /opt/usg-watchdog/.env)
EnvironmentFile=-/opt/usg-watchdog/.env

# Logging via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usg-watchdog

# --- Capabilities ---
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# --- Sandboxing ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/usg-watchdog
ReadWritePaths=/var/log/usg-watchdog.log
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
DevicePolicy=closed
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
